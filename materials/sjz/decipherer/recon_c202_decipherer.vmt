
"VertexLitGeneric"
{
    "$basetexture" "sjz\decipherer\Recon_C202_Decipherer"
    "$bumpmap" "sjz\decipherer\Recon_C202_Decipherer_n"
  
$nocull 1
$model 1	
"$blendTintByBaseAlpha"	"1"
"$PhongDisableHalfLambert" "1"


	//TRANSPARENCY AND AO:


	$lightwarptexture "sjz\decipherer\lightwarp_soft"


	"$rimlight" "1"
	"$rimlightboost" "0.35"

	//IMPORTANT:

	"$phong" "1"						
	"$phongboost"	"0.02" 		
	"$phongexponenttexture" "sjz\decipherer\phongwarp_sheen" 
 				 "$emissiveBlendEnabled" "1"
 "$emissiveBlendTexture" "vgui\white"
 "$emissiveBlendBaseTexture" "sjz\decipherer\Recon_C202_Decipherer_e"
 "$emissiveBlendFlowTexture" "vgui\white"
 "$emissiveBlendTint" "[1 1 1]"
 "$emissiveBlendStrength" "1"
 "$emissiveBlendScrollVector" "[0.0]"

	"$nodecal" 1

}
